# URL of the infoclimat-om-worker (basemap tile-proxy, labels overlay).
# When unset, those features are disabled.
# Local dev: VITE_OM_WORKER_URL=http://localhost:8080
VITE_OM_WORKER_URL=

# Bucket R2 des produits précalculés (anomalies, etc.). Sans valeur, le
# pseudo-domaine "Anomalie T°" n'apparaît pas dans le sélecteur.
VITE_MODELS_BUCKET_URL=

# Bucket des fichiers .om Weather AI (WeatherNext, modèle IA expérimental),
# distinct du bucket ci-dessus. Sans valeur, le modèle « Weather AI
# (WeatherNext) » n'apparaît pas dans le sélecteur.
VITE_WEATHER_AI_OM_BUCKET_URL=

# Hôtes supplémentaires autorisés à atteindre le dev/preview server, séparés
# par des virgules (en plus de localhost, toujours permis). Utile pour tester
# depuis un mobile via un reverse proxy / tunnel. Un point initial = wildcard
# de sous-domaines. Aucun effet en prod (build statique).
# Ex : DEV_ALLOWED_HOSTS=.home.example.com,monapp.ngrok.app
DEV_ALLOWED_HOSTS=

# API Weather AI du portail (cartes expérimentales cyclones). Défaut : le portail
# public, appelé en direct (CORS ouvert). Optionnel, pour passer par le proxy du
# dev/preview server (vite.config.ts) :
# VITE_WEATHER_AI_API_URL=/api/weather-ai
VITE_WEATHER_AI_API_URL=

# Cônes d'incertitude cycloniques publics : on (défaut, affichés quand le champ
# `cones` du catalogue les annonce), off (retrait), fixture (démo dev).
VITE_WEATHER_AI_CONES=

# Real User Monitoring OpenObserve (src/lib/rum.ts). Sans client token, le RUM
# est inactif. Le token RUM (OpenObserve → Ingestion → RUM) est un jeton
# d'ingestion seule, exposé côté navigateur par conception. Site, org et
# application ont des défauts (openobserve.cmer.fr, default, infoclimat-maps).
# VITE_OO_RUM_CLIENT_TOKEN=
# VITE_OO_RUM_ENV=production
# % des sessions suivies (défaut 10) et % de ces sessions enregistrées en replay (défaut 10)
# VITE_OO_RUM_SESSION_SAMPLE_RATE=10
# VITE_OO_RUM_REPLAY_SAMPLE_RATE=10
