{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "infoclimat-numeric",
	"compatibility_date": "2026-05-30",
	// Static app plus a read-only relay for the Weather AI API.
	"main": "server/worker.ts",
	"assets": {
		"directory": "build",
		"binding": "ASSETS",
		"run_worker_first": ["/api/weather-ai/*"],
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	}
}
